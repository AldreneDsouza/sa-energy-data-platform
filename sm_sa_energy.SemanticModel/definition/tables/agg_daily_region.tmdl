table agg_daily_region
	lineageTag: d0ec4b38-0c0c-43f3-b708-1ea8a65184d4
	sourceLineageTag: [dbo].[agg_daily_region]

	measure 'Avg Spot Price' = AVERAGE(fact_dispatch_interval[spot_price])
		lineageTag: 7968b049-d31e-40c9-82b4-26060b6211b6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Demand MW' = MAX(fact_dispatch_interval[total_demand_mw])
		lineageTag: 02f7aad4-fa34-4c62-9bbc-8c0e3480c6c1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Demand MW' = AVERAGE(fact_dispatch_interval[total_demand_mw])
		lineageTag: 74cb0200-6177-43c1-8ef9-9cf009deeb79

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Negative Price Intervals' =
			
			CALCULATE(
			    COUNTROWS(fact_dispatch_interval),
			    fact_dispatch_interval[is_negative_price] = TRUE()
			)
		formatString: 0
		lineageTag: 1606e160-fc0b-408d-9d4c-7e924637a1c1

		changedProperty = Name

	measure 'Negative Price %' =
			
			DIVIDE(
			    [Negative Price Intervals],
			    COUNTROWS(fact_dispatch_interval),
			    0
			) * 100
		lineageTag: 9e487fe0-1e1f-4f3a-8b6c-cdc49aff7909

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Energy Served MWh' = SUMX(fact_dispatch_interval, fact_dispatch_interval[total_demand_mw] / 12)
		lineageTag: a79e6343-1da0-4e08-864e-68ef5eef367b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

